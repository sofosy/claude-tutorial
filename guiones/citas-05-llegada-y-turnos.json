        },
        {
          "resaltar": "button:has-text('Llamar')",
          "durante_ms": 3000,
          "al_decir": "Las áreas"
        },
        {
          "resaltar": ".statistics-row",
          "durante_ms": 3500,
          "al_decir": "Con esto termina"
        }
      ]
    }
  ]
