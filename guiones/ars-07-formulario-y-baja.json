    {
      "id": "01-formulario",
      "capitulo": "El formulario de reclamación",
      "rotulo": "Formulario de reclamación",
      "navegar": "/patients/547?tab=ars",
      "ruta": "Pacientes › ficha › ARS › Reclamaciones a la ARS",
      "texto_pantalla": "El formulario por servicios prestados, lleno con los datos del paciente",
      "narracion": "Algunas ARS piden, además de la factura y el anexo, el formulario de reclamación por servicios prestados de cada paciente, firmado por el médico. Está en la ficha del paciente, pestaña ARS, en Reclamaciones a la ARS. Abro la de Carolina. El formulario sale lleno con sus datos, su afiliación, la autorización y los servicios. Elijo el médico tratante: escribo su nombre, y elijo a la doctora Ana cuando aparece en la lista. Con el médico puesto, guardo los cambios del formulario. Desde aquí se descarga en PDF, o se imprime para que el médico lo firme.",
      "acciones": [
        {
          "resaltar": ":text('Reclamaciones a la ARS') >> xpath=..",
          "durante_ms": 3000,
          "al_decir": "en Reclamaciones a la ARS"
        },
        {
          "click": "button[aria-label^='Abrir la reclamación'] >> nth=0",
          "al_decir": "Abro la de Carolina"
        },
        {
          "resaltar": "app-patient-claim-form-tab",
          "durante_ms": 4000,
          "al_decir": "sale lleno",
          "cursor": false
        },
        {
          "click": "app-patient-claim-form-tab app-autocomplete input",
          "al_decir": "Elijo el médico"
        },
        {
          "teclear": "Ana",
          "al_decir": "escribo su nombre"
        },
        {
          "click": "mat-option:has-text('Ana') >> nth=0",
          "al_decir": "cuando aparece"
        },
        {
          "click": "app-patient-claim-form-tab button:has-text('Guardar')",
          "al_decir": "guardo los cambios"
        },
        {
          "resaltar": "app-patient-claim-form-tab button:has-text('Descargar PDF')",
          "durante_ms": 2500,
          "al_decir": "se descarga en PDF"
        },
        {
          "resaltar": "app-patient-claim-form-tab button:has-text('Imprimir')",
          "durante_ms": 2500,
          "al_decir": "o se imprime"
        }
      ]
    },
    {
      "id": "02-baja",
      "capitulo": "Dar de baja lo no cobrado",
      "rotulo": "Dar de baja",
      "navegar": "/health-insurance/reclamaciones",
      "al_decir_navegar": "La ARS respondió",
      "ruta": "Seguros de Salud › Reclamaciones › Seguimiento › Dar de baja lo no cobrado",
      "texto_pantalla": "Lo que la ARS no va a pagar sale de su cuenta por cobrar, con su asiento",
      "narracion": "Volvamos a la glosa de Carolina. La ARS respondió la apelación y mantuvo la glosa: esos seiscientos cuarenta no se van a cobrar. Abro la pestaña de Seguimiento. En la fila de Carolina abro su menú, y pulso Dar de baja lo no cobrado. El cuadro dice cuánto queda sin cobrar y que sale de la cuenta por cobrar de la aseguradora como ajuste, con su asiento; lo ya cobrado no cambia. Escribo el motivo: que la ARS mantuvo la glosa tras la apelación. Revisado el texto, confirmo con el botón Dar de baja. Un momento después, el aviso confirma el ajuste; lo cierro. La reclamación queda cerrada, y con eso la cuenta de la ARS cuadra con lo que de verdad pagó.",
      "acciones": [
        {
          "click": "button:has-text('Seguimiento')",
          "al_decir": "Abro la pestaña"
        },
        {
          "click": "tr:has-text('CLM-2026-000203') button:has(mat-icon:text('more_vert'))",
          "al_decir": "abro su menú"
        },
        {
          "click": ".mat-mdc-menu-content button:has-text('Dar de baja')",
          "al_decir": "pulso Dar de baja"
        },
        {
          "resaltar": "mat-dialog-container",
          "durante_ms": 5000,
          "al_decir": "El cuadro dice",
          "cursor": false
        },
        {
          "escribir": {
            "sel": "mat-dialog-container textarea",
            "texto": "La ARS mantuvo la glosa tras la apelación."
          },
          "al_decir": "Escribo el motivo"
        },
        {
          "click": "mat-dialog-container button:has-text('Dar de baja')",
          "al_decir": "confirmo con el botón"
        },
        {
          "resaltar": "mat-dialog-container:has(app-custom-alert-dialog)",
          "durante_ms": 1800,
          "al_decir": "el aviso confirma",
          "cursor": false
        },
        {
          "click": "button:has-text('Entendido')",
          "al_decir": "lo cierro"
        },
        {
          "resaltar": "tr:has-text('CLM-2026-000203') td >> nth=-3",
          "durante_ms": 3500,
          "al_decir": "queda cerrada"
        }
      ]
    }
  ]
