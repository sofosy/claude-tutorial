    {
      "id": "01-lote",
      "capitulo": "Preparar la entrega",
      "rotulo": "Entrega y cobro",
      "navegar": "/health-insurance/reclamaciones",
      "ruta": "Seguros de Salud › Reclamaciones › Entrega y cobro",
      "texto_pantalla": "El lote: el paquete físico que se le entrega a la ARS",
      "narracion": "Ya emitimos la factura a ARS Humano. Ahora hay que entregársela, con sus reclamaciones, y seguir lo que pase después. Eso se hace en el paso cuatro, Entrega y cobro. Pulso Preparar entrega y elijo la remesa de noviembre. El aviso dice que se armó un lote con sus tres reclamaciones; lo cierro. La fila del lote dice en qué paso va y cuál le falta.",
      "acciones": [
        {
          "click": "button:has-text('Entrega y cobro')",
          "al_decir": "el paso cuatro"
        },
        {
          "click": "button:has-text('Preparar entrega')",
          "al_decir": "Pulso Preparar entrega"
        },
        {
          "click": ".mat-mdc-menu-content button:has-text('Noviembre 2026')",
          "al_decir": "elijo la remesa"
        },
        {
          "resaltar": "mat-dialog-container:has(app-custom-alert-dialog)",
          "durante_ms": 2200,
          "al_decir": "El aviso dice",
          "cursor": false
        },
        {
          "click": "button:has-text('Entendido')",
          "al_decir": "lo cierro. La"
        },
        {
          "resaltar": "tr:has-text('BATCH-202611-0001') td >> nth=-3",
          "durante_ms": 3500,
          "al_decir": "en qué paso va"
        }
      ]
    },
    {
      "id": "02-entregar",
      "capitulo": "Cerrar y entregar",
      "rotulo": "Cerrar y entregar",
      "ruta": "Seguros de Salud › Reclamaciones › Entrega y cobro › Lote",
      "texto_pantalla": "Cerrado: no admite más reclamaciones. Entregado: las reclamaciones pasan a Enviadas",
      "narracion": "El siguiente paso es cerrar el lote, para que no entre nada más. Pulso Cerrar lote y confirmo. El aviso dice que quedó cerrado, y lo cierro. Cuando el mensajero lleva el paquete a la ARS, pulso Entregar. El sistema pide confirmar; confirmo, y sus reclamaciones pasan a enviadas, con la fecha de hoy.",
      "acciones": [
        {
          "click": "tr:has-text('BATCH-202611-0001') button:has-text('Cerrar lote')",
          "al_decir": "Pulso Cerrar lote"
        },
        {
          "click": "mat-dialog-container button:has-text('Cerrar Lote')",
          "al_decir": "y confirmo. El"
        },
        {
          "resaltar": "mat-dialog-container:has(app-custom-alert-dialog)",
          "durante_ms": 1500,
          "al_decir": "El aviso dice que quedó",
          "cursor": false
        },
        {
          "click": "button:has-text('Entendido')",
          "al_decir": "y lo cierro. Cuando"
        },
        {
          "click": "tr:has-text('BATCH-202611-0001') button:has-text('Entregar')",
          "al_decir": "pulso Entregar"
        },
        {
          "click": "button:has-text('Sí, Enviar')",
          "al_decir": "confirmo, y sus"
        },
        {
          "resaltar": "mat-dialog-container:has(app-custom-alert-dialog)",
          "durante_ms": 1800,
          "al_decir": "pasan a enviadas",
          "cursor": false
        },
        {
          "click": "button:has-text('Entendido')",
          "al_decir": "con la fecha de hoy"
        }
      ]
    },
    {
      "id": "03-acuse",
      "capitulo": "El acuse de recibo",
      "rotulo": "Registrar acuse",
      "ruta": "Seguros de Salud › Reclamaciones › Entrega y cobro › Acuse",
      "texto_pantalla": "El número con el que la ARS recibió el lote",
      "narracion": "La ARS sella la entrega con un número de acuse. En la fila pulso Registrar acuse. En el cuadro escribo el número que dio la ARS, tal como aparece en el sello, y lo guardo con el botón de abajo. El aviso confirma que el lote queda en procesamiento por la aseguradora; lo cierro. La fila ya muestra el número de acuse, y su siguiente paso es registrar el cobro cuando la ARS pague. En el próximo video vemos ese pago, con una glosa.",
      "acciones": [
        {
          "click": "tr:has-text('BATCH-202611-0001') button:has-text('Registrar acuse')",
          "al_decir": "En la fila pulso"
        },
        {
          "resaltar": "mat-dialog-container",
          "durante_ms": 1800,
          "al_decir": "En el cuadro",
          "cursor": false
        },
        {
          "escribir": {
            "sel": "mat-dialog-container input",
            "texto": "ACU-2026-1187"
          },
          "al_decir": "escribo el número"
        },
        {
          "click": "mat-dialog-container button:has-text('Registrar Acuse')",
          "al_decir": "lo guardo con el botón"
        },
        {
          "resaltar": "mat-dialog-container:has(app-custom-alert-dialog)",
          "durante_ms": 1800,
          "al_decir": "El aviso confirma que el lote",
          "cursor": false
        },
        {
          "click": "button:has-text('Entendido')",
          "al_decir": "lo cierro. La fila"
        },
        {
          "resaltar": "tr:has-text('BATCH-202611-0001') td >> nth=-3",
          "durante_ms": 3500,
          "al_decir": "siguiente paso es registrar"
        }
      ]
    }
