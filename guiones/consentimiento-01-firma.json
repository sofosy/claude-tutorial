        {
          "click": "mat-checkbox >> nth=1",
          "al_decir": "pudo hacer sus"
        },
        {
          "click": "mat-checkbox >> nth=2",
          "al_decir": "que puede revocarlo"
        },
        {
          "click": "mat-checkbox >> nth=3",
          "al_decir": "que autoriza el"
        },
        {
          "resaltar": "mat-radio-group, :text('Firmo como')",
