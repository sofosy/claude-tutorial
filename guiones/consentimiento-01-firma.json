  "pasos": [
    {
      "id": "01-nuevo",
      "capitulo": "Un consentimiento nuevo",
      "rotulo": "Consentimiento informado",
      "navegar": "/patients",
      "ruta": "Pacientes › ficha › Consentimiento Informado General",
      "texto_pantalla": "El consentimiento se redacta en la ficha del paciente",
      "narracion": "En este video la doctora Ana Pérez prepara el consentimiento de un procedimiento, la paciente lo firma y queda la constancia en su expediente. Abro a Rosa Elena Martínez. En la ficha, debajo de Plantillas, está Consentimiento Informado General: viene asignado a todos los médicos, y el centro puede crear los suyos en las plantillas clínicas. Lo abro y pulso Nueva. El documento ya trae los datos de la paciente, su cédula, y el nombre y el exequátur de la doctora.",
      "acciones": [
        {
          "click": "button:has-text('Rosa Elena')",
          "al_decir": "Abro a Rosa Elena"
        },
        {
          "resaltar": "button.tab:has-text('Consentimiento Informado General')",
          "durante_ms": 4000,
          "al_decir": "debajo de Plantillas"
        },
        {
          "click": "button.tab:has-text('Consentimiento Informado General')",
          "al_decir": "Lo abro"
        },
        {
          "click": "button:has(mat-icon:text('add_circle'))",
          "al_decir": "pulso Nueva"
        },
        {
          "resaltar": ".ck-editor__editable p:has-text('Yo, Rosa Elena')",
          "durante_ms": 3500,
          "al_decir": "los datos de la paciente"
        },
        {
          "resaltar": ".ck-editor__editable p:has-text('exequátur')",
          "durante_ms": 3000,
          "al_decir": "el exequátur"
        }
      ]
    },
    {
      "id": "02-llenar",
      "capitulo": "Procedimiento, riesgos y alternativas",
      "rotulo": "Llenar los espacios",
      "ruta": "Pacientes › ficha › Consentimiento › Redacción",
      "texto_pantalla": "Las líneas en blanco son lo que la doctora explica a la paciente",
      "narracion": "Lo que falta son las líneas en blanco, y se llenan con palabras que la paciente entienda. Primero el procedimiento: drenaje de un absceso en el brazo derecho, tal como se lo dije a ella. En la línea de abajo, cómo se hace: con anestesia local, en el mismo consultorio. Después, los riesgos que le expliqué en la consulta, los frecuentes y también los suyos propios. En la otra línea, lo que puede quedarle después, que es una pequeña cicatriz. Por último, las alternativas razonables, incluida la de no hacer nada. Un consentimiento con huecos sin llenar no se puede enviar a firmar.",
      "acciones": [
        {
          "click": ".ck-editor__editable p:has-text('_____') >> nth=0",
          "veces": 3,
          "al_decir": "el procedimiento: drenaje"
        },
        {
          "teclear": "Drenaje de un absceso en el brazo derecho,"
        },
        {
          "click": ".ck-editor__editable p:has-text('_____') >> nth=0",
          "veces": 3,
          "al_decir": "En la línea de abajo"
        },
        {
          "teclear": "con anestesia local."
        },
        {
          "click": ".ck-editor__editable p:has-text('_____') >> nth=0",
          "veces": 3,
          "al_decir": "los riesgos que le expliqué"
        },
        {
          "teclear": "Dolor, sangrado leve o infección."
        },
        {
          "click": ".ck-editor__editable p:has-text('_____') >> nth=0",
          "veces": 3,
          "al_decir": "En la otra línea"
        },
        {
          "teclear": "Una pequeña cicatriz en la zona."
        },
        {
          "click": ".ck-editor__editable p:has-text('_____') >> nth=0",
          "veces": 3,
          "al_decir": "las alternativas razonables"
        },
        {
          "teclear": "Tratamiento con antibióticos, o no hacer nada."
        }
      ]
    },
    {
      "id": "03-completar",
      "capitulo": "Completar y elegir cómo firma",
      "rotulo": "Completar",
      "ruta": "Pacientes › ficha › Consentimiento › Aceptación del paciente",
      "texto_pantalla": "En el consultorio o por correo",
      "narracion": "Debajo del documento, la aceptación del paciente espera a que el registro esté completo. El botón Guardar solo lo deja en borrador. Ahora pulso Completar. El aviso lo confirma, y se abre la aceptación del paciente. Hay dos formas de firmar. Por correo, a la paciente le llega un enlace personal y firma desde su casa: eliges cuántos días vale y se le recuerda antes de vencer. Mientras no firme, el enlace se puede reenviar o cancelar. Pero lo más común es que firme aquí mismo, así que elijo En el consultorio. Antes de abrir el documento, pedirá los últimos cuatro dígitos de su cédula.",
      "acciones": [
        {
          "resaltar": "button:has(mat-icon:text('save'))",
          "durante_ms": 1500,
          "al_decir": "El botón Guardar"
        },
        {
          "click": "button:has-text('Completar')",
          "al_decir": "Ahora pulso Completar"
        },
        {
          "resaltar": ".mat-mdc-snack-bar-label, simple-snack-bar",
          "durante_ms": 1800,
          "al_decir": "El aviso lo confirma",
          "cursor": false
        },
        {
          "resaltar": "app-consent-request-panel",
          "durante_ms": 3000,
          "al_decir": "se abre la aceptación"
        },
        {
          "click": "app-consent-request-panel [role=radio]:has-text('Por correo')",
          "al_decir": "Por correo, a la paciente"
        },
        {
          "resaltar": "app-consent-request-panel mat-form-field:has-text('Vigencia del enlace')",
          "durante_ms": 3500,
          "al_decir": "cuántos días vale"
        },
        {
          "click": "app-consent-request-panel [role=radio]:has-text('En el consultorio')",
          "al_decir": "elijo En el consultorio"
        },
        {
          "resaltar": "app-consent-request-panel :text('Identidad: últimos 4 dígitos')",
          "durante_ms": 3500,
          "al_decir": "los últimos cuatro dígitos"
        }
      ]
    },
    {
      "id": "04-identidad",
      "capitulo": "La paciente confirma que es ella",
      "rotulo": "Identidad",
      "ruta": "Página de firma (lo que ve la paciente)",
      "texto_pantalla": "Últimos 4 dígitos de la cédula · enlace personal",
      "narracion": "Ahora es el turno de la paciente. Pulso Abrir para firmar y le paso la pantalla, o la tableta. Se abre la página de firma, con el nombre del centro arriba. Esta es su página: no ve nada del sistema, solo su documento. Escribe los últimos cuatro dígitos de su cédula y pulsa Continuar.",
      "acciones": [
        {
          "click": "app-consent-request-panel button:has-text('Abrir para firmar')",
          "al_decir": "Pulso Abrir para firmar"
        },
        {
