          "durante_ms": 2500,
          "al_decir": "Ver constancia"
        },
        {
          "resaltar": "app-consent-request-panel button:has-text('Revocar')",
          "durante_ms": 2500,
          "al_decir": "Revocar registra"
        },
        {
