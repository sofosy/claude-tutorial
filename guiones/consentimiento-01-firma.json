          "durante_ms": 3000,
          "al_decir": "la bitácora"
        },
        {
          "click": "button:has(mat-icon:text('draw'))",
          "al_decir": "pulso Firmar"
        },
        {
          "resaltar": "mat-dialog-container",
          "durante_ms": 2500,
