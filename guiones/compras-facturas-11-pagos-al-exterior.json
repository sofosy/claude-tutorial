     "al_decir": "en la moneda"
    },
    {
     "click": "mat-form-field:has(mat-label:has-text('Moneda')) mat-select >> nth=-1",
     "al_decir": "abro la lista"
    },
    {
     "click": "mat-option:has-text('USD')",
     "al_decir": "elijo dólar estadounidense"
    },
    {
     "presionar": {
      "tecla": "Escape"
     },
     "al_decir": "y el sistema"
    },
