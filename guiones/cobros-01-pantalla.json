  {
   "id": "02-filtros",
   "capitulo": "Filtros y botones",
   "rotulo": "Filtros y botones",
   "ruta": "Ventas › Cobros",
   "texto_pantalla": "Búsqueda · Tipo · Cliente",
   "narracion": "Arriba están los filtros. Búsqueda encuentra un recibo por su número, su factura o su cliente. Tipo empieza en Solo cobros; también puedes ver Solo anticipos, que son pagos recibidos antes de facturar, o Todos. Y Cliente muestra solo los recibos de un cliente. A la derecha están los dos botones para cobrar. Registrar cobro cobra una sola factura. Cobrar varias facturas reparte un solo pago entre varias facturas del mismo cliente. Los dos se explican en los videos siguientes.",
   "acciones": [
    {
     "resaltar": "mat-form-field:has(mat-label:text-is('Búsqueda'))",
     "durante_ms": 3000,
     "al_decir": "Búsqueda encuentra",
     "cursor": false
    },
    {
     "resaltar": "mat-form-field:has(mat-label:text-is('Tipo'))",
     "durante_ms": 3500,
     "al_decir": "Tipo empieza en Solo cobros",
     "cursor": false
    },
    {
     "resaltar": "mat-form-field:has(mat-label:text-is('Cliente'))",
     "durante_ms": 3000,
     "al_decir": "Cliente muestra solo",
     "cursor": false
    },
    {
     "resaltar": "button:has-text('Registrar cobro')",
     "durante_ms": 3000,
     "al_decir": "Registrar cobro cobra una sola",
     "cursor": false
    },
    {
     "resaltar": "button:has-text('Cobrar varias facturas')",
     "durante_ms": 3500,
     "al_decir": "Cobrar varias facturas reparte",
     "cursor": false
    }
   ]
