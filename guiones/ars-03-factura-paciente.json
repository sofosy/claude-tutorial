  "pasos": [
    {
      "id": "01-cobrar",
      "capitulo": "Cobrar la consulta atendida",
      "rotulo": "Cobrar consulta",
      "navegar": "/agenda/calendar",
      "ruta": "Calendario › la cita › Cobrar consulta",
      "texto_pantalla": "La paciente paga su copago; lo que cubre la ARS se le factura a ella aparte",
      "narracion": "Un servicio con seguro lleva dos facturas: la de la paciente, solo por lo que ella paga, y la de la ARS, por lo que cubre, que se hace después en Reclamaciones. Empezamos por la de Rosa, que ya terminó su consulta con la doctora Ana. Lo más práctico es cobrarla desde la agenda: en la lista del día abro su cita, que está atendida, y pulso Cobrar consulta. Como su ARS tiene convenio para esta consulta y ya hay una autorización aprobada, el sistema avisa que se factura desde la autorización, para que lo que cubre la ARS quede por reclamar. Pulso Facturar desde la autorización.",
      "acciones": [
        {
          "resaltar": "a.rail-item[aria-label='Seguros de Salud']",
          "durante_ms": 2500,
          "al_decir": "en Reclamaciones"
        },
        {
          "click": ".view-toggle-btn >> nth=3",
          "al_decir": "en la lista"
        },
        {
          "click": ".fc-list-event:has-text('Rosa') >> nth=0",
          "al_decir": "abro su cita"
        },
        {
          "click": "button:has-text('Cobrar consulta')",
          "al_decir": "pulso Cobrar consulta"
        },
        {
          "resaltar": "mat-dialog-container:has(app-custom-alert-dialog)",
          "durante_ms": 6000,
          "al_decir": "el sistema avisa",
          "cursor": false
        },
        {
          "click": "button:has-text('Facturar desde la autorización')",
          "al_decir": "Pulso Facturar desde"
        }
      ]
    },
    {
      "id": "02-factura",
      "capitulo": "La factura del paciente",
      "rotulo": "Factura del paciente",
      "ruta": "Ventas › Facturas › Nueva factura (médica)",
      "texto_pantalla": "El servicio completo, menos lo que cubre la ARS: el copago",
      "narracion": "Se abre la factura ya armada con su autorización. La paciente queda fija mientras se use su cobertura, y el comprobante es de consumo. Abajo están su aseguradora, su plan y su póliza. La línea trae la consulta de dos mil quinientos, con lo que cubre la ARS. El resumen lo deja claro: dos mil quinientos de servicio, menos dos mil de cobertura, y un total a pagar de quinientos.",
      "acciones": [
        {
          "resaltar": ":text('El paciente no puede cambiarse')",
          "durante_ms": 3500,
          "al_decir": "queda fija"
        },
        {
          "resaltar": ":text('COBERTURA DEL PACIENTE') >> xpath=..",
          "durante_ms": 3500,
          "al_decir": "su aseguradora"
        },
        {
          "resaltar": ":text('COBERT. ARS')",
          "durante_ms": 3000,
          "al_decir": "con lo que cubre"
        },
        {
          "resaltar": "app-document-cost-summary",
          "durante_ms": 3500,
          "al_decir": "El resumen lo deja claro"
        },
        {
          "resaltar": ".invoice-total-block",
          "durante_ms": 3000,
          "al_decir": "un total a pagar"
        }
      ]
    },
    {
      "id": "03-cobro",
      "capitulo": "Cobrar el copago",
      "rotulo": "Guardar y cobrar",
      "ruta": "Ventas › Facturas › Nueva factura › Cobro",
      "texto_pantalla": "Efectivo, tarjeta o transferencia; la factura queda saldada",
      "narracion": "Más abajo está el cobro. Rosa paga en efectivo, así que elijo Efectivo. Me entrega justo quinientos, y pulso Exacto: el monto recibido es el mismo que se cobra. El aviso de abajo confirma que se cobran quinientos y la factura queda saldada. Pulso Guardar y cobrar. En ese paso se emite el comprobante y se registra el cobro, y la factura queda en contabilidad. El aviso dice cobro procesado; pulso Aceptar.",
      "acciones": [
        {
          "click": "button:has-text('Efectivo')",
          "al_decir": "elijo Efectivo"
        },
        {
          "click": "button:has-text('Exacto')",
          "al_decir": "pulso Exacto"
        },
        {
          "resaltar": ":text('la factura queda')",
          "durante_ms": 3000,
          "al_decir": "El aviso de abajo"
        },
        {
          "click": "button:has-text('Guardar y cobrar')",
          "al_decir": "Pulso Guardar y cobrar"
        },
        {
          "resaltar": "mat-dialog-container:has(app-custom-alert-dialog)",
          "durante_ms": 1800,
          "al_decir": "El aviso dice",
          "cursor": false
        },
        {
          "click": "button:has-text('Aceptar')",
          "al_decir": "pulso Aceptar"
        }
      ]
    },
    {
      "id": "04-resultado",
      "capitulo": "La factura pagada",
      "rotulo": "Factura pagada",
      "ruta": "Ventas › Facturas › Ver factura",
      "texto_pantalla": "Pagada, con su comprobante; la autorización queda utilizada",
      "narracion": "La factura queda pagada, con su número de comprobante. El resumen de pagos dice lo cobrado y que no queda nada pendiente, y desde aquí se imprime la factura, o también el recibo del pago. La autorización pasa a utilizada: ya no se puede facturar otra vez. Lo que cubrió la ARS queda en Reclamaciones, por reclamar.",
      "acciones": [
        {
          "resaltar": ":text('Pagada') >> nth=0",
          "durante_ms": 3000,
          "al_decir": "queda pagada"
        },
        {
          "resaltar": ":text('B0200000001')",
          "durante_ms": 2500,
          "al_decir": "número de comprobante"
        },
        {
          "resaltar": ":text('Resumen de Pagos') >> xpath=..",
          "durante_ms": 3500,
          "al_decir": "El resumen de pagos"
        },
        {
          "resaltar": "button:has-text('Imprimir') >> nth=0",
          "durante_ms": 2500,
          "al_decir": "se imprime"
        },
        {
          "resaltar": "button:has-text('Imprimir recibo')",
          "durante_ms": 2500,
          "al_decir": "el recibo del pago"
        },
        {
          "resaltar": ":text('Cobertura ARS') >> nth=0",
          "durante_ms": 3000,
          "al_decir": "Lo que cubrió la ARS"
        }
      ]
    },
    {
      "id": "05-ficha",
      "capitulo": "La otra forma: desde la ficha",
      "rotulo": "Desde la ficha",
      "navegar": "/patients/545?tab=ars",
      "al_decir_navegar": "Cuando el servicio",
      "ruta": "Pacientes › ficha › ARS",
      "texto_pantalla": "Sin cita que cobrar: menú de la autorización › Facturar esta autorización",
      "narracion": "Veamos la otra forma. Cuando el servicio no viene de una cita, por ejemplo un laboratorio, la factura se hace desde la ficha del paciente, en la pestaña ARS: en el menú de la autorización aprobada está Facturar esta autorización, y abre la misma factura. La de Rosa ya aparece utilizada. En el próximo video se lo reclamamos a la ARS y le emitimos su factura.",
      "acciones": [
        {
          "resaltar": ":text('Cobertura del paciente') >> xpath=..",
          "durante_ms": 3000,
          "al_decir": "desde la ficha"
        },
        {
          "resaltar": ":text('ARS AUT-551207') >> xpath=ancestor::*[contains(@class,'tabx__row')][1]",
          "durante_ms": 5000,
          "al_decir": "en el menú de la autorización"
        },
        {
          "resaltar": ":text('Utilizada') >> nth=0",
          "durante_ms": 3000,
          "al_decir": "ya aparece utilizada"
        }
      ]
    }
  ]
}
