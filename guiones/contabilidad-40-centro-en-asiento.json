  "pasos": [
    {
      "id": "01-linea",
      "capitulo": "Centro por línea",
      "rotulo": "Centro de costo en la línea",
      "ruta": "Contabilidad › Diario y Mayor › Nuevo asiento",
      "texto_pantalla": "Cada línea de gasto lleva su centro",
      "narracion": "Los centros de costo se usan al registrar. En Diario y Mayor recojo el menú, y pulso Crear Asiento. Voy a registrar los gastos de noviembre. Escribo la descripción, y agrego la primera línea. En la cuenta busco Fletes. La elijo, y en el débito anoto veinte mil pesos. Este flete es de Logística: en la columna Centro de Costo escribo Log. Aparece en la lista, y lo elijo. Así este gasto queda imputado a Logística.",
      "acciones": [
        {
          "click": "button.panel-collapse",
          "al_decir": "recojo el menú"
        },
        {
          "click": "button:has-text('Crear Asiento')",
          "al_decir": "pulso Crear Asiento"
        },
        {
          "escribir": {
            "sel": "textarea[formcontrolname='description']",
            "texto": "Gastos de noviembre"
          },
          "al_decir": "Escribo la descripción"
        },
        {
          "click": "button.add-line-button",
          "al_decir": "agrego la primera línea"
        },
        {
          "escribir": {
            "sel": ".table-row >> nth=0 >> input[placeholder='Buscar cuenta...']",
            "texto": "Fletes"
          },
          "al_decir": "En la cuenta busco"
        },
        {
          "click": "mat-option:has-text('6.03.10')",
          "al_decir": "La elijo, y en el débito"
        },
        {
          "escribir": {
            "sel": ".table-row >> nth=0 >> input[formcontrolname='debitAmount']",
            "texto": "20000"
          },
          "al_decir": "anoto veinte mil pesos"
        },
        {
          "escribir": {
            "sel": ".table-row >> nth=0 >> input[placeholder='Centro de costo...']",
            "texto": "Log"
          },
          "al_decir": "escribo Log"
        },
        {
          "click": "mat-option:has-text('CC-LOG')",
          "al_decir": "y lo elijo"
        }
      ]
    },
    {
      "id": "02-reparto",
      "capitulo": "Repartir entre centros",
      "rotulo": "Repartir entre centros",
      "ruta": "Contabilidad › Diario y Mayor › Nuevo asiento",
      "texto_pantalla": "Un gasto compartido se reparte por porcentaje",
      "narracion": "Agrego la segunda línea: el alquiler del local de ventas, que comparten las dos sucursales. En su cuenta busco Arrend. La elijo, y en el débito anoto treinta mil pesos. En lugar de un solo centro, pulso el botón de repartir. En el primer centro abro la lista, y elijo Ventas Santo Domingo. En su porcentaje anoto sesenta. Abajo abro el segundo centro, y elijo Ventas Santiago. Y en su porcentaje, el cuarenta restante. El total dice cien por ciento, y aplico. La línea queda repartida en dos centros.",
      "acciones": [
        {
          "click": "button.add-line-button",
          "al_decir": "Agrego la segunda línea"
        },
        {
          "escribir": {
            "sel": ".table-row >> nth=1 >> input[placeholder='Buscar cuenta...']",
            "texto": "Arrend"
          },
          "al_decir": "En su cuenta busco"
        },
        {
          "click": "mat-option:has-text('6.03.02')",
          "al_decir": "La elijo, y en el débito"
        },
        {
          "escribir": {
            "sel": ".table-row >> nth=1 >> input[formcontrolname='debitAmount']",
            "texto": "30000"
          },
          "al_decir": "anoto treinta mil pesos"
        },
        {
          "click": "button[aria-label='Repartir la línea 2 entre varios centros']",
          "al_decir": "pulso el botón de repartir"
        },
        {
          "click": "mat-dialog-container mat-select[formcontrolname='costCenter'] >> nth=0",
          "al_decir": "abro la lista"
        },
        {
          "click": "mat-option:has-text('CC-VEN-SD')",
          "al_decir": "elijo Ventas Santo Domingo"
        },
        {
          "escribir": {
            "sel": "mat-dialog-container input[formcontrolname='percentage'] >> nth=0",
            "texto": "60"
          },
          "al_decir": "anoto sesenta"
        },
        {
          "click": "mat-dialog-container mat-select[formcontrolname='costCenter'] >> nth=1",
          "al_decir": "abro el segundo centro"
        },
        {
          "click": "mat-option:has-text('CC-VEN-STI')",
          "al_decir": "elijo Ventas Santiago"
        },
        {
          "escribir": {
            "sel": "mat-dialog-container input[formcontrolname='percentage'] >> nth=1",
            "texto": "40"
          },
          "al_decir": "el cuarenta restante"
        },
        {
          "resaltar": "mat-dialog-container :text('Total:') >> nth=0",
          "durante_ms": 2500,
          "cursor": false,
          "al_decir": "El total dice"
        },
        {
          "click": "mat-dialog-container button:has-text('Aplicar')",
          "al_decir": "y aplico"
        },
        {
          "resaltar": ".table-row >> nth=1 >> button[aria-label*='Repartid'], .table-row >> nth=1 >> button:has-text('Repartid')",
          "durante_ms": 3500,
          "cursor": false,
          "al_decir": "La línea queda repartida"
        }
      ]
    }
  ]
}
