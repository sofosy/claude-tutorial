  "pasos": [
    {
      "id": "01-aprobar",
      "capitulo": "Aprobar los cargos",
      "rotulo": "Cargos del ingreso",
      "navegar": "/hospitalization/charges",
      "ruta": "Hospitalización › Cargos",
      "texto_pantalla": "Lo que se le hace al paciente ingresado entra como cargo pendiente",
      "narracion": "Durante un ingreso, cada servicio que recibe el paciente entra como un cargo: laboratorios, estudios, medicamentos, la habitación. Están en Hospitalización, Cargos. Daniel tiene tres: el hemograma y el electrocardiograma ya aprobados, y una sonografía pendiente. Un cargo pendiente no se factura hasta que alguien lo revisa y lo aprueba. En su fila pulso Aprobar, y confirmo. El aviso dice que quedó aprobado; lo cierro.",
      "acciones": [
        {
          "resaltar": "tr:has-text('Hemograma completo')",
          "durante_ms": 3000,
          "al_decir": "Están en Hospitalización"
        },
        {
          "resaltar": "tr:has-text('Sonografía abdominal') td >> nth=-2",
          "durante_ms": 3500,
          "al_decir": "una sonografía pendiente"
        },
        {
          "click": "tr:has-text('Sonografía abdominal') button:has(mat-icon:text('check_circle'))",
          "al_decir": "En su fila pulso Aprobar"
        },
        {
          "click": "mat-dialog-container:has(app-custom-alert-dialog) button:has-text('Aprobar')",
          "al_decir": "y confirmo"
        },
        {
          "resaltar": "mat-dialog-container:has(app-custom-alert-dialog)",
          "durante_ms": 1800,
          "al_decir": "dice que quedó aprobado",
          "cursor": false
        },
        {
          "click": "button:has-text('Entendido')",
          "al_decir": "lo cierro"
        }
      ]
    },
    {
      "id": "02-facturar",
      "capitulo": "Facturar cargos",
      "rotulo": "Facturar cargos",
      "navegar": "/patients/554?tab=cuenta",
      "al_decir_navegar": "En la ficha",
      "ruta": "Pacientes › ficha › Cuenta › Cargos del ingreso",
      "texto_pantalla": "Una factura con los cargos aprobados que aún no se han facturado",
      "narracion": "Ahora los facturamos. En la ficha de Daniel, pestaña Cuenta, están los cargos del ingreso con su estado y el acumulado. Los tres están aprobados. Pulso Facturar cargos. El sistema arma una sola factura con los cargos aprobados que aún no tienen factura, y el aviso dice cuántos entraron. Se puede facturar antes o después del alta, y las veces que haga falta: un cargo facturado no vuelve a entrar. Pulso Abrir la factura.",
      "acciones": [
        {
          "resaltar": ":text('Cargos del ingreso') >> xpath=..",
          "durante_ms": 3500,
          "al_decir": "están los cargos"
        },
        {
          "resaltar": ".acc__total",
          "durante_ms": 3000,
          "al_decir": "y el acumulado"
        },
        {
          "click": "button:has-text('Facturar cargos')",
          "al_decir": "Pulso Facturar cargos"
        },
        {
          "resaltar": "mat-dialog-container:has(app-custom-alert-dialog)",
          "durante_ms": 5000,
          "al_decir": "y el aviso dice",
          "cursor": false
        },
        {
          "click": "button:has-text('Abrir la factura')",
          "al_decir": "Pulso Abrir la"
        }
      ]
    },
    {
      "id": "03-factura",
      "capitulo": "La factura del ingreso",
      "rotulo": "La factura",
      "ruta": "Ventas › Facturas › Factura del ingreso",
      "texto_pantalla": "En borrador: se revisa, se emite y se cobra como cualquier factura",
      "narracion": "La factura queda en borrador, a nombre de Daniel, con una línea por servicio y el número del ingreso en las notas. Lo que tiene el mismo servicio y el mismo precio, como la habitación de cada día, va en una sola línea. Desde aquí se revisa, se emite y se cobra como cualquier factura. Si algún cargo tuviera cobertura de la ARS, el sistema no lo factura aquí: se factura desde la autorización del paciente, como vimos en la serie de seguros.",
      "acciones": [
        {
          "resaltar": ":text('Borrador') >> nth=0",
          "durante_ms": 2500,
          "al_decir": "queda en borrador"
        },
        {
          "resaltar": ":text('Líneas del documento') >> xpath=ancestor::*[3]",
          "durante_ms": 4000,
          "al_decir": "una línea por servicio"
        },
        {
          "resaltar": ".invoice-total-block",
          "durante_ms": 3000,
          "al_decir": "se emite y se cobra"
        }
      ]
    }
  ]
}
