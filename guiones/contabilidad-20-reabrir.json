        {
          "resaltar": "tr.mat-mdc-row:has-text('Marzo 2026') .gm-badge >> nth=-1",
          "durante_ms": 3000,
          "cursor": false,
          "al_decir": "el estado vuelve a Abierto"
        }
      ]
    },
    {
