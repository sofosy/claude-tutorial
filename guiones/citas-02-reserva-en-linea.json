            "texto": "gabriela.fernandez@correo.test"
          },
          "al_decir": "Escribe su correo"
        },
        {
          "click": "app-portal-entry button.btn--primary:has-text('Continuar')",
          "al_decir": "pulsa Continuar"
        }
      ]
    },
    {
      "id": "04-codigo",
      "capitulo": "Verificar el código y sus datos",
      "rotulo": "Código de verificación",
      "ruta": "Enlace de reservas › Código",
      "setup": {
        "tipo": "shell",
        "cmd": "node seeds/clinica/codigo-portal.mjs gabriela.fernandez@correo.test",
        "guardar_en": "codigo"
      },
      "texto_pantalla": "El código vence en 30 minutos y admite tres intentos",
      "narracion": "El código vence en treinta minutos. Lo copia del correo y lo escribe aquí. Son seis números, y tiene tres intentos. Ahora pulsa Verificar código. Como es la primera vez que entra, completa su nombre: Gabriela, tal como quiere que aparezca. Después su primer apellido: Fernández. El segundo apellido es opcional. Pulsa Guardar datos y continuar.",
      "acciones": [
        {
          "escribir": {
