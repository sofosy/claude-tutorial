    {
      "id": "01-enlace",
      "capitulo": "El enlace de reservas del centro",
      "rotulo": "Enlace de reservas",
      "navegar": "/book/centro/los-prados",
      "al_decir_navegar": "abro el enlace",
      "ruta": "Enlace de reservas del centro (lo que ve el paciente)",
      "texto_pantalla": "Enlace de reservas · especialidad, médico y hora",
      "narracion": "Me pongo en el lugar de la paciente y abro el enlace de reservas del centro, como lo haría desde su teléfono. Es uno solo para todos los médicos: se copia desde la Disponibilidad de cualquier médico y se comparte por WhatsApp, en redes o en la página web. Arriba están los pasos de la reserva. Cada tarjeta es una especialidad, con su médico y su próximo turno. Gabriela necesita una consulta general, así que elige Medicina General.",
      "acciones": [
        {
          "resaltar": ".topbar",
          "durante_ms": 3500,
          "al_decir": "uno solo"
        },
        {
          "resaltar": ".steps",
          "durante_ms": 3500,
          "al_decir": "los pasos"
        },
        {
          "resaltar": "button.specialty >> nth=0",
          "durante_ms": 3500,
          "al_decir": "Cada tarjeta"
        },
        {
          "click": "button.specialty:has-text('Medicina General')",
          "al_decir": "elige Medicina General"
        }
      ]
    },
    {
      "id": "02-hora",
      "capitulo": "Elegir médico y hora",
      "rotulo": "Médico y hora",
      "ruta": "Enlace de reservas › Medicina General",
      "texto_pantalla": "Médicos de la especialidad con sus próximos turnos",
      "narracion": "Salen los médicos de esa especialidad, primero quien atiende antes, con su consultorio y sus próximos turnos. Tocar una hora ya elige médico y turno, pero ella quiere otro día, así que pulsa Ver más días y horas en la doctora Ana Pérez. Se abre la semana de la doctora: los días apagados no tienen cupo. Toca un día, y abajo salen las horas de la mañana. Elige una, y el resumen de abajo confirma el día y la hora. Pulsa Continuar.",
      "acciones": [
        {
          "resaltar": "article.card:has-text('Ana Pérez')",
          "durante_ms": 4000,
          "al_decir": "Salen los médicos"
        },
        {
          "resaltar": "article.card:has-text('Ana Pérez') .slots",
          "durante_ms": 3500,
          "al_decir": "Tocar una hora"
        },
        {
          "click": "article.card:has-text('Ana Pérez') button.link",
          "al_decir": "Ver más días"
        },
        {
          "resaltar": ".days",
          "durante_ms": 3500,
          "al_decir": "los días apagados"
        },
        {
          "click": "button.day:not([disabled]) >> nth=1",
          "al_decir": "Toca un día"
        },
        {
          "click": "button.slot >> nth=2",
          "al_decir": "Elige una"
        },
        {
          "resaltar": ".selection",
          "durante_ms": 3000,
          "al_decir": "el resumen"
        },
        {
          "click": "button.btn--primary:has-text('Continuar')",
          "al_decir": "Pulsa Continuar"
        }
      ]
    },
    {
      "id": "03-correo",
      "capitulo": "Entrar con el correo",
      "rotulo": "Correo y acceso",
      "ruta": "Enlace de reservas › Correo y acceso",
      "texto_pantalla": "Correo y acceso · un código de seis dígitos",
      "narracion": "A la derecha queda el resumen de la reserva: la doctora, el consultorio, la duración y el precio particular de su consulta. Para reservar, la paciente entra con su correo: así sus citas quedan en su portal. Escribe su correo, el mismo donde quiere recibir los avisos de sus citas, y pulsa Continuar. Le llega un código de seis dígitos.",
      "acciones": [
        {
          "resaltar": ".summary, aside",
          "durante_ms": 4500,
          "al_decir": "el resumen",
          "cursor": false
        },
        {
          "escribir": {
