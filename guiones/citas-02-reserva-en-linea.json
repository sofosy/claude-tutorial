        },
        {
          "click": "button:has-text('Guardar datos y continuar')",
          "al_decir": "Pulsa Guardar"
        }
      ]
    },
    {
      "id": "05-confirmar",
      "capitulo": "Para quién es y confirmar",
      "rotulo": "Confirmar la cita",
      "ruta": "Enlace de reservas › Paciente › Confirmación",
      "texto_pantalla": "Para mí o para una persona a mi cargo · Confirmar cita",
      "narracion": "Ahora dice para quién es la cita: para ella, o para una persona a su cargo, como un hijo, con su relación y su fecha de nacimiento. Es para ella. Pulsa Revisar la cita. Revisa el paciente y a qué correo le llegarán los avisos, y pulsa Confirmar cita. La reserva quedó confirmada, con su número. Desde aquí la agrega a su calendario, reserva otra o la cancela si no puede ir.",
      "acciones": [
        {
          "resaltar": "input[name='patient-choice'] >> xpath=ancestor::label[1] >> nth=1",
          "durante_ms": 3500,
          "al_decir": "una persona a su cargo"
        },
        {
          "click": "input[name='patient-choice'] >> nth=0",
          "al_decir": "Es para ella"
        },
        {
          "click": "button:has-text('Revisar la cita')",
          "al_decir": "Pulsa Revisar"
        },
        {
          "click": "button[type='submit']",
          "al_decir": "pulsa Confirmar cita"
        },
        {
          "resaltar": ":text('Tu reserva quedó confirmada')",
          "durante_ms": 4000,
          "al_decir": "quedó confirmada",
          "cursor": false
        }
      ]
    },
    {
      "id": "06-sin-ficha",
      "capitulo": "Reservas sin ficha: vincular al paciente",
      "rotulo": "Reservas sin ficha",
      "navegar": "/agenda/reservas-sin-ficha",
      "ruta": "Calendario › Reservas sin ficha",
      "texto_pantalla": "Reservas sin ficha · verificar la identidad y vincular",
      "narracion": "Ahora la recepción. En el Calendario, Reservas sin ficha. Si el correo de Gabriela estuviera en su ficha, la cita se habría creado sola. Pero su ficha no lo tiene, así que el centro todavía no sabe quién es: el turno está apartado, pero no es una cita ni sale en el calendario. Cada reserva tiene sus acciones. Registrar paciente crea la ficha con los datos de la reserva, si es nueva. Si la reserva quedó pendiente, Confirmar turno la confirma; esta ya está confirmada. Y Cancelar reserva libera el horario. Gabriela ya es paciente, así que pulso Vincular paciente. La busco por su nombre, o por su cédula, y pulso Buscar. Aparece su ficha; verifico que es ella, pulso Vincular esta ficha. El sistema pregunta si la vinculo, y confirmo. Ahora sí se crea la cita, con su médico y su turno: el aviso lo confirma, y a Gabriela le llega la confirmación por correo.",
      "acciones": [
        {
          "resaltar": "h2:has-text('Gabriela')",
          "durante_ms": 3500,
          "al_decir": "el correo de Gabriela"
        },
        {
          "resaltar": "h2:has-text('Gabriela') >> xpath=..",
          "durante_ms": 4000,
          "al_decir": "el turno está apartado"
        },
        {
          "resaltar": "a:has-text('Registrar paciente')",
          "durante_ms": 3000,
          "al_decir": "Registrar paciente"
        },
        {
