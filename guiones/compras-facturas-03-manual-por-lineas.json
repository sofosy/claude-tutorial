      "texto": "2"
     },
     "al_decir": "dos"
    },
    {
     "escribir": {
      "sel": "mat-dialog-container input[formcontrolname='unitPrice'] >> nth=1",
      "texto": "450"
     },
     "al_decir": "cuatrocientos cincuenta"
    },
    {
