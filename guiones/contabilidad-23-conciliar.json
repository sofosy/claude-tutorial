  "pasos": [
    {
      "id": "01-nueva",
      "capitulo": "Nueva conciliación",
      "rotulo": "Nueva Conciliación",
      "ruta": "Contabilidad › Banca › Conciliaciones",
      "texto_pantalla": "Cuenta · período · saldos del extracto",
      "narracion": "Conciliar es comparar el estado de cuenta del banco con lo registrado en libros. Recojo el menú y pulso Nueva Conciliación. Le pongo una referencia para encontrarla después: CONC-BHD-SEP. Luego, en Cuenta Bancaria, escribo BHD para buscarla. Aparece la cuenta del BHD, y la elijo. El período contable ya viene con el actual. Las fechas del extracto: del primero de septiembre de dos mil veintiséis. Hasta el treinta de septiembre del mismo año. Copio los saldos del extracto: el inicial, cien mil pesos, que debe coincidir con el cierre del mes anterior. Y el saldo final del extracto, ciento dieciséis mil setecientos veinte. El saldo en libros lo calcula el sistema desde el Mayor. Guardo.",
      "acciones": [
        {
          "click": "button.panel-collapse",
          "al_decir": "Recojo el menú"
        },
        {
          "click": "button:has-text('Nueva Conciliación')",
          "al_decir": "pulso Nueva Conciliación"
        },
        {
          "escribir": {
            "sel": "input[formcontrolname='referenceNumber']",
            "texto": "CONC-BHD-SEP"
          },
          "al_decir": "Le pongo una referencia"
        },
        {
          "escribir": {
            "sel": "mat-form-field:has(mat-label:text-is('Cuenta Bancaria')) input",
            "texto": "BHD"
          },
          "al_decir": "escribo BHD para buscarla"
        },
        {
          "click": "mat-option:has-text('9600123456')",
          "al_decir": "y la elijo"
        },
        {
          "resaltar": "mat-form-field:has(mat-label:text-is('Período Contable'))",
          "durante_ms": 2500,
          "cursor": false,
          "al_decir": "El período contable ya viene"
        },
        {
          "escribir": {
            "sel": "input[formcontrolname='statementStartDate']",
            "texto": "01/09/2026"
          },
          "al_decir": "Las fechas del extracto"
        },
        {
          "escribir": {
            "sel": "input[formcontrolname='statementEndDate']",
            "texto": "30/09/2026"
          },
          "al_decir": "Hasta el treinta"
        },
        {
          "escribir": {
            "sel": "input[formcontrolname='openingBalance']",
            "texto": "100000"
          },
          "al_decir": "el inicial, cien mil"
        },
        {
          "escribir": {
            "sel": "input[formcontrolname='closingBalance']",
            "texto": "116720"
          },
          "al_decir": "Y el saldo final del extracto"
        },
        {
          "click": "button:has-text('Guardar')",
          "al_decir": "Guardo"
        }
      ]
    },
    {
      "id": "02-importar",
      "capitulo": "Importar el estado de cuenta",
      "rotulo": "Importar estado de cuenta",
      "ruta": "Contabilidad › Banca › Conciliación",
      "texto_pantalla": "Archivo → columnas → revisar e importar",
      "narracion": "Con la conciliación creada, pulso Importar estado de cuenta. El asistente tiene tres pasos: archivo, columnas y revisión. Subo el archivo que exporté del banco, en CSV. El sistema detectó sus columnas, así que paso al siguiente paso. Ahora le digo qué trae cada columna. La fecha está en la primera columna del archivo. La descripción del movimiento está en la segunda columna. La referencia del banco viene en la tercera. Y el monto, que viene con signo, está en la cuarta. Con eso, pulso Previsualizar y reviso las líneas antes de importarlas. Si le pongo nombre, el mapeo se guarda como plantilla para el próximo mes. Importo: el asistente confirma las cinco líneas importadas, y pulso Listo.",
      "acciones": [
        {
          "click": "button:has-text('Importar estado de cuenta')",
          "al_decir": "pulso Importar estado de cuenta"
        },
        {
          "resaltar": "mat-dialog-container >> nth=0",
          "durante_ms": 2500,
          "cursor": false,
          "al_decir": "El asistente tiene tres pasos"
        },
        {
          "subir": {
            "sel": "mat-dialog-container input[type=file]",
            "ancla": "mat-dialog-container button:has-text('Seleccionar archivo')",
            "archivo": "seeds/contabilidad/estado-bhd-septiembre.csv"
          },
          "al_decir": "Subo el archivo"
        },
        {
          "click": "mat-dialog-container button:has-text('Siguiente')",
          "al_decir": "así que paso al siguiente"
        },
        {
          "click": "mat-select[formcontrolname='dateColumn']",
          "al_decir": "La fecha está"
        },
        {
          "click": "mat-option:has-text('0: Fecha')",
          "al_decir": "en la primera columna del archivo"
        },
        {
          "click": "mat-select[formcontrolname='descriptionColumn']",
          "al_decir": "La descripción del movimiento"
        },
        {
          "click": "mat-option:has-text('1: Descripcion')",
          "al_decir": "está en la segunda columna"
        },
        {
          "click": "mat-select[formcontrolname='referenceColumn']",
          "al_decir": "La referencia del banco"
        },
        {
          "click": "mat-option:has-text('2: Referencia')",
          "al_decir": "viene en la tercera"
        },
        {
          "click": "mat-select[formcontrolname='amountColumn']",
          "al_decir": "Y el monto"
        },
        {
          "click": "mat-option:has-text('3: Monto')",
          "al_decir": "está en la cuarta"
        },
        {
          "click": "mat-dialog-container button:has-text('Previsualizar')",
          "al_decir": "pulso Previsualizar"
        },
        {
          "escribir": {
            "sel": "mat-dialog-container input[placeholder*='Banco Popular']",
            "texto": "BHD - CSV"
          },
          "al_decir": "Si le pongo nombre"
        },
        {
          "click": "mat-dialog-container button:has-text('Importar')",
          "al_decir": "Importo"
        },
        {
          "resaltar": "mat-dialog-container >> nth=0",
          "durante_ms": 2000,
          "cursor": false,
          "al_decir": "el asistente confirma"
        },
        {
          "click": "mat-dialog-container button:has-text('Listo')",
          "al_decir": "y pulso Listo"
        }
      ]
    },
    {
      "id": "03-conciliar",
      "capitulo": "Conciliar partidas",
      "rotulo": "Conciliar con sugerencias",
      "ruta": "Contabilidad › Banca › Conciliación",
      "texto_pantalla": "Sugerencias → el asiento del banco → Usar",
      "narracion": "Las cinco partidas llegan como Falta en libros, y la diferencia es de diecisiete mil. El depósito y el pago del alquiler ya están registrados en libros, cada uno con un asiento. En el depósito pulso la bombilla de sugerencias. El sistema encontró el asiento del depósito, con el mismo monto y la misma fecha. Pulso Usar, y la partida queda Conciliada. Con el pago del alquiler hago lo mismo: abro sus sugerencias, aparece el asiento del alquiler con su monto, y lo uso. La diferencia queda en cero. Las comisiones y los intereses solo están en el banco: no se concilian, porque se registran al completar.",
      "acciones": [
        {
          "resaltar": ".total-item:has-text('Diferencia')",
          "durante_ms": 3000,
          "cursor": false,
          "al_decir": "la diferencia es de diecisiete mil"
