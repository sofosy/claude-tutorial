          "al_decir": "Pulso Usar"
        },
        {
          "resaltar": "tr:has-text('DEPOSITO') mat-chip",
          "durante_ms": 2500,
          "cursor": false,
          "al_decir": "queda Conciliada"
        },
        {
          "click": "tr:has-text('PAGO ALQUILER') button:has(mat-icon:text-is('lightbulb'))",
          "al_decir": "abro sus sugerencias"
        },
        {
          "resaltar": "mat-dialog-container .candidate >> nth=0",
          "durante_ms": 2000,
          "cursor": false,
          "al_decir": "aparece el asiento del alquiler"
        },
        {
          "click": "mat-dialog-container .candidate >> nth=0 >> button:has-text('Usar')",
