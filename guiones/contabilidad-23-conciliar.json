        {
          "resaltar": "tr:has-text('COMISION MANEJO') td >> nth=1",
          "durante_ms": 4000,
          "cursor": false,
          "al_decir": "Las comisiones y los intereses"
        }
      ]
    },
    {
      "id": "04-reclasificar",
      "capitulo": "Conciliar partidas",
      "rotulo": "Reclasificar",
      "ruta": "Contabilidad › Banca › Conciliación",
      "texto_pantalla": "Tipo: comisión, interés, depósito, retiro",
      "narracion": "El sistema clasifica cada partida por su descripción. El servicio de banca en línea quedó como retiro, pero es una comisión del banco. Pulso su tipo y elijo Comisión bancaria. Así se contabilizará con las demás comisiones.",
      "acciones": [
        {
          "resaltar": "tr:has-text('COMISION MANEJO') button.type-chip",
          "durante_ms": 3000,
          "cursor": false,
          "al_decir": "El sistema clasifica cada partida"
        },
        {
          "resaltar": "tr:has-text('SERVICIO BANCA') button.type-chip",
          "durante_ms": 3000,
          "cursor": false,
          "al_decir": "quedó como retiro"
        },
        {
          "click": "tr:has-text('SERVICIO BANCA') button.type-chip",
          "al_decir": "Pulso su tipo"
        },
        {
          "click": ".mat-mdc-menu-item:has-text('Comisión bancaria')",
          "al_decir": "y elijo Comisión bancaria"
        },
        {
          "resaltar": "tr:has-text('SERVICIO BANCA')",
          "durante_ms": 3000,
          "cursor": false,
          "al_decir": "Así se contabilizará"
        }
      ]
    },
    {
      "id": "05-completar",
      "capitulo": "Completar",
      "rotulo": "Completar",
      "ruta": "Contabilidad › Banca › Conciliación",
      "texto_pantalla": "Contabiliza comisiones e intereses",
      "narracion": "Con la diferencia en cero, pulso Completar. La confirmación explica que se contabilizan las comisiones e intereses y la conciliación queda cerrada. Confirmo. El aviso confirma que los ajustes quedaron contabilizados: un asiento de comisiones por cuatrocientos pesos y uno de intereses por ciento veinte, con fecha del corte. La conciliación queda Completada, y el saldo del banco en libros es igual al del extracto.",
      "acciones": [
        {
          "click": "button:has-text('Completar')",
          "al_decir": "pulso Completar"
        },
        {
          "resaltar": "mat-dialog-container >> nth=0",
          "durante_ms": 3500,
          "cursor": false,
          "al_decir": "La confirmación explica"
        },
        {
          "click": "mat-dialog-container button:has-text('Completar')",
          "al_decir": "Confirmo"
        },
        {
          "resaltar": ".mat-mdc-snack-bar-container",
          "durante_ms": 3500,
