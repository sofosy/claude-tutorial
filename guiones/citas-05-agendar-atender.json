          "al_decir": "elijo al doctor"
        },
        {
          "click": "mat-dialog-container mat-select[formcontrolname='appointmentTypeCatalogId']",
          "al_decir": "el tipo de cita"
        },
        {
          "click": "mat-option:has-text('Consulta general')",
          "al_decir": "elijo consulta general"
