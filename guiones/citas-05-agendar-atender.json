  "pasos": [
    {
      "id": "01-nueva",
      "capitulo": "Agendar una cita",
      "rotulo": "Nueva cita",
      "ruta": "Calendario › Nueva cita",
      "texto_pantalla": "Paciente, médico y servicio · después el turno",
      "narracion": "Una paciente llama para pedir cita. Entro al calendario, en el menú de la izquierda, y pulso Nueva cita. Primero el paciente: escribo Laura, y cuando aparece en la lista, la elijo. Debajo sale su ficha, con la edad, la cédula y el teléfono. Ahora el médico: escribo Jorge, y en la lista que se abre elijo al doctor Jorge Medina. Con el médico elegido, el tipo de cita ofrece solo los servicios que él da: elijo consulta general. Debajo se resumen su duración, la modalidad y la tarifa. El motivo de la consulta es lo que necesita atender la paciente: elijo chequeo general en la lista.",
      "acciones": [
        {
          "click": "nav.module-rail [aria-label='Calendario']",
          "al_decir": "Entro al calendario"
        },
        {
          "click": "button:has-text('Nueva Cita')",
          "al_decir": "pulso Nueva"
        },
        {
          "escribir": {
            "sel": "mat-dialog-container input[formcontrolname='patientSearch']",
            "texto": "Laura"
          },
          "al_decir": "escribo Laura"
        },
        {
          "click": "mat-option:has-text('Laura Patricia')",
          "al_decir": "la elijo"
        },
        {
          "resaltar": "mat-dialog-container .patient-card, mat-dialog-container .pc, mat-dialog-container :text('Cédula 402-0555009-9')",
          "durante_ms": 3500,
          "al_decir": "su ficha"
        },
        {
          "escribir": {
            "sel": "mat-dialog-container input[formcontrolname='doctorSearch']",
            "texto": "Jorge"
          },
          "al_decir": "escribo Jorge"
        },
        {
