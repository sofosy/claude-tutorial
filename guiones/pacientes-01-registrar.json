        },
        {
          "escribir": {
            "sel": "mat-form-field:has-text('Teléfono principal') input >> nth=-1",
            "texto": "8095550122"
          },
          "al_decir": "Después su teléfono"
        },
        {
          "resaltar": "mat-form-field:has-text('Parentesco') >> nth=-1",
          "durante_ms": 3500,
          "al_decir": "La relación"
