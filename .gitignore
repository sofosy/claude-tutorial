# Configuración de esta máquina: rutas, credenciales y datos de demo.
# Nunca se versiona. Usa config.ejemplo.json como plantilla.
config.local.json

# Salidas generadas: videos, audio, frames y, sobre todo, capturas del sistema
# real. Aquí es donde con más facilidad se filtra información de clientes.
salida/
fichas/

# Contenido de una serie concreta que NO se versiona. Los guiones (guiones/),
# la preparación de datos (seeds/) y los videos publicados (entregas/) SÍ se
# versionan: son lo que permite regrabar un tutorial con otra voz o tras un
# cambio de pantalla sin rehacer el trabajo.
# git no admite comentarios en la misma línea del patrón: van aparte.
# demo/      sitio de ejemplo de un tutorial concreto
# PLAN-*.md  el plan de una serie (PLAN.md, el del motor, sí se versiona)
demo/
PLAN-*.md
image.png

# Entorno y dependencias
.venv/
__pycache__/
*.py[cod]

# Material pesado o de referencia
*.mp4
*.mov
*.mp3
*.aiff
*.srt

# Excepción: lo entregado de cada tutorial (video final, subtítulos) sí va al repo
!entregas/**/*.mp4
!entregas/**/*.srt

# Sistema
.DS_Store
Note.md

# Binarios de fuentes locales (se regeneran con fuentes/preparar.sh)
fuentes/*.woff2
